    hsimbjetNormalizedTrackPhi = (TH1D*)hsimbjetTrackPhi->Clone("hsimbjetNormalizedTrackPhi");
    hsimbjetNormalizedTrackEta = (TH1D*)hsimbjetTrackEta->Clone("hsimbjetNormalizedTrackEta");

    // related Impact parameter

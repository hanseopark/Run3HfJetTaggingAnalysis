      hsimbjetNormalizedJP = (TH1D*)hsimbjetJP->Clone("hsimbjetNormalizedJP");
      hsimbjetNormalizedJPLog = (TH1D*)hsimbjetJPLog->Clone("hsimbjetNormalizedJPLog");

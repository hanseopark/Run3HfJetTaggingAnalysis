      hsimbjetNormalizedPtJPLog = (TH2D*)hsimbjetPtJPLog->Clone("hsimbjetNormalizedPtJPLog");
    }
  }
}

void HfJetTaggingTCAnalysis::ProjectionHist(bool doTC, bool doJP) {
  if (doTC) {
    int binsToFlavour[] = {1, 2, 3}; // 1: charm, 2: beauty, 3: light flavour
    int numBinsToFlavour = sizeof(binsToFlavour) / sizeof(binsToFlavour[0]);
    for (int i=0; i<numBinsToFlavour; i++) {
      int binZ = binsToFlavour[i];
      TH1F* projTrackPt = reinterpret_cast<TH1F*> (h3simjetPtTrackPtFlavour->ProjectionY(Form("projTrackPt_%d", binZ), 1, h3simjetPtTrackPtFlavour->GetNbinsX(), binZ, binZ));
      TH1F* projTrackEta = reinterpret_cast<TH1F*> (h3simjetPtTrackEtaFlavour->ProjectionY(Form("projTrackEta_%d", binZ), 1, h3simjetPtTrackEtaFlavour->GetNbinsX(), binZ, binZ));
      TH1F* projTrackPhi = reinterpret_cast<TH1F*> (h3simjetPtTrackPhiFlavour->ProjectionY(Form("projTrackPhi_%d", binZ), 1, h3simjetPtTrackPhiFlavour->GetNbinsX(), binZ, binZ));
      TH1F* projImpXY = reinterpret_cast<TH1F*> (h3simjetPtImpXYFlavour->ProjectionY(Form("projImpXY_%d", binZ), 1, h3simjetPtImpXYFlavour->GetNbinsX(), binZ, binZ));
      TH1F* projSignImpXY = reinterpret_cast<TH1F*> (h3simjetPtSignImpXYFlavour->ProjectionY(Form("projSignImpXY_%d", binZ), 1, h3simjetPtSignImpXYFlavour->GetNbinsX(), binZ, binZ));
      TH1F* projImpXYSig = reinterpret_cast<TH1F*> (h3simjetPtImpXYSigFlavour->ProjectionY(Form("projImpXYSig_%d", binZ), 1, h3simjetPtImpXYSigFlavour->GetNbinsX(), binZ, binZ));
      TH1F* projSignImpXYSig = reinterpret_cast<TH1F*> (h3simjetPtSignImpXYSigFlavour->ProjectionY(Form("projSignImpXYSig_%d", binZ), 1, h3simjetPtSignImpXYSigFlavour->GetNbinsX(), binZ, binZ));
      TH1F* projImpZ = reinterpret_cast<TH1F*> (h3simjetPtImpZFlavour->ProjectionY(Form("projImpZ_%d", binZ), 1, h3simjetPtImpZFlavour->GetNbinsX(), binZ, binZ));
      TH1F* projSignImpZ = reinterpret_cast<TH1F*> (h3simjetPtSignImpZFlavour->ProjectionY(Form("projSignImpZ_%d", binZ), 1, h3simjetPtSignImpZFlavour->GetNbinsX(), binZ, binZ));
      TH1F* projImpZSig = reinterpret_cast<TH1F*> (h3simjetPtImpZSigFlavour->ProjectionY(Form("projImpZSig_%d", binZ), 1, h3simjetPtImpZSigFlavour->GetNbinsX(), binZ, binZ));
      TH1F* projSignImpZSig = reinterpret_cast<TH1F*> (h3simjetPtSignImpZSigFlavour->ProjectionY(Form("projSignImpZSig_%d", binZ), 1, h3simjetPtSignImpZSigFlavour->GetNbinsX(), binZ, binZ));
      TH1F* projImpXYZ = reinterpret_cast<TH1F*> (h3simjetPtImpXYZFlavour->ProjectionY(Form("projImpXYZ_%d", binZ), 1, h3simjetPtImpXYZFlavour->GetNbinsX(), binZ, binZ));
      TH1F* projSignImpXYZ = reinterpret_cast<TH1F*> (h3simjetPtSignImpXYZFlavour->ProjectionY(Form("projSignImpXYZ_%d", binZ), 1, h3simjetPtSignImpXYZFlavour->GetNbinsX(), binZ, binZ));
      TH1F* projImpXYZSig = reinterpret_cast<TH1F*> (h3simjetPtImpXYZSigFlavour->ProjectionY(Form("projImpXYZSig_%d", binZ), 1, h3simjetPtImpXYZSigFlavour->GetNbinsX(), binZ, binZ));
      TH1F* projSignImpXYZSig = reinterpret_cast<TH1F*> (h3simjetPtSignImpXYZSigFlavour->ProjectionY(Form("projSignImpXYZSig_%d", binZ), 1, h3simjetPtSignImpXYZSigFlavour->GetNbinsX(), binZ, binZ));
      TH1F* projSignImpXYSigN1 = reinterpret_cast<TH1F*> (h3simjetPtSignImpXYSigFlavourN1->ProjectionY(Form("projSignImpXYSigN1_%d", binZ), 1, h3simjetPtSignImpXYSigFlavourN1->GetNbinsX(), binZ, binZ));
      TH1F* projSignImpXYSigN2 = reinterpret_cast<TH1F*> (h3simjetPtSignImpXYSigFlavourN2->ProjectionY(Form("projSignImpXYSigN2_%d", binZ), 1, h3simjetPtSignImpXYSigFlavourN2->GetNbinsX(), binZ, binZ));
      TH1F* projSignImpXYSigN3 = reinterpret_cast<TH1F*> (h3simjetPtSignImpXYSigFlavourN3->ProjectionY(Form("projSignImpXYSigN3_%d", binZ), 1, h3simjetPtSignImpXYSigFlavourN3->GetNbinsX(), binZ, binZ));

      // inclusive
      hsimjetTrackPt[0][0]->Add(projTrackPt);
      hsimjetTrackEta[0][0]->Add(projTrackEta);
      hsimjetTrackPhi[0][0]->Add(projTrackPhi);
      hsimjetImpXY[0][0]->Add(projImpXY);
      hsimjetSignImpXY[0][0]->Add(projSignImpXY);
      hsimjetImpXYSig[0][0]->Add(projImpXYSig);
      hsimjetSignImpXYSig[0][0]->Add(projSignImpXYSig);
      hsimjetImpZ[0][0]->Add(projImpZ);
      hsimjetSignImpZ[0][0]->Add(projSignImpZ);
      hsimjetImpZSig[0][0]->Add(projImpZSig);
      hsimjetSignImpZSig[0][0]->Add(projSignImpZSig);
      hsimjetImpXYZ[0][0]->Add(projImpXYZ);
      hsimjetSignImpXYZ[0][0]->Add(projSignImpXYZ);
      hsimjetImpXYZSig[0][0]->Add(projImpXYZSig);
      hsimjetSignImpXYZSig[0][0]->Add(projSignImpXYZSig);
      hsimjetSignImpXYSigN1[0][0]->Add(projSignImpXYSigN1);
      hsimjetSignImpXYSigN2[0][0]->Add(projSignImpXYSigN2);
      hsimjetSignImpXYSigN3[0][0]->Add(projSignImpXYSigN3);

      // jet flavour
      hsimjetTrackPt[i+1][0] = reinterpret_cast<TH1F*>(projTrackPt->Clone());
      hsimjetTrackEta[i+1][0] = reinterpret_cast<TH1F*>(projTrackEta->Clone());
      hsimjetTrackPhi[i+1][0] = reinterpret_cast<TH1F*>(projTrackPhi->Clone());
      hsimjetImpXY[i+1][0] = reinterpret_cast<TH1F*>(projImpXY->Clone());
      hsimjetSignImpXY[i+1][0] = reinterpret_cast<TH1F*>(projSignImpXY->Clone());
      hsimjetImpXYSig[i+1][0] = reinterpret_cast<TH1F*>(projImpXYSig->Clone());
      hsimjetSignImpXYSig[i+1][0] = reinterpret_cast<TH1F*>(projSignImpXYSig->Clone());
      hsimjetImpZ[i+1][0] = reinterpret_cast<TH1F*>(projImpZ->Clone());
      hsimjetSignImpZ[i+1][0] = reinterpret_cast<TH1F*>(projSignImpZ->Clone());
      hsimjetImpZSig[i+1][0] = reinterpret_cast<TH1F*>(projImpZSig->Clone());
      hsimjetSignImpZSig[i+1][0] = reinterpret_cast<TH1F*>(projSignImpZSig->Clone());
      hsimjetImpXYZ[i+1][0] = reinterpret_cast<TH1F*>(projImpXYZ->Clone());
      hsimjetSignImpXYZ[i+1][0] = reinterpret_cast<TH1F*>(projSignImpXYZ->Clone());
      hsimjetImpXYZSig[i+1][0] = reinterpret_cast<TH1F*>(projImpXYZSig->Clone());
      hsimjetSignImpXYZSig[i+1][0] = reinterpret_cast<TH1F*>(projSignImpXYZSig->Clone());
      hsimjetSignImpXYSigN1[i+1][0] = reinterpret_cast<TH1F*>(projSignImpXYSigN1->Clone());
      hsimjetSignImpXYSigN2[i+1][0] = reinterpret_cast<TH1F*>(projSignImpXYSigN2->Clone());
      hsimjetSignImpXYSigN3[i+1][0] = reinterpret_cast<TH1F*>(projSignImpXYSigN3->Clone());

      for (int binJetPt =1; binJetPt<HfJetTagging::nBinsJetPt+1; binJetPt++) {
        int leftbinJetPtTrackPt = h3simjetPtTrackPtFlavour->GetXaxis()->FindBin(HfJetTagging::binsJetPt[binJetPt-1]);
        int rightbinJetPtTrackPt = h3simjetPtTrackPtFlavour->GetXaxis()->FindBin(HfJetTagging::binsJetPt[binJetPt]);
        TH1F* projJetPtRangeTrackPt = reinterpret_cast<TH1F*> (h3simjetPtTrackPtFlavour->ProjectionY(Form("projJetPtRangeTrackPt_%d_%d", binJetPt, binZ), leftbinJetPtTrackPt, rightbinJetPtTrackPt, binZ, binZ));
        hsimjetTrackPt[i+1][binJetPt] = reinterpret_cast<TH1F*>(projJetPtRangeTrackPt->Clone()); 
        hsimjetTrackPt[0][binJetPt]->Add(projJetPtRangeTrackPt);
        //std::cout << "binJetPt: " << binJetPt << " left x value: " << h3simjetPtTrackPtFlavour->GetXaxis()->GetBinCenter(leftbinJetPtTrackPt) << " right x value: " << h3simjetPtTrackPtFlavour->GetXaxis()->GetBinCenter(rightbinJetPtTrackPt) << std::endl;
        //histogram->GetXaxis()->GetBinCenter(binNumber)

        int leftbinJetPtTrackEta = h3simjetPtTrackEtaFlavour->GetXaxis()->FindBin(HfJetTagging::binsJetPt[binJetPt-1]);
        int rightbinJetPtTrackEta = h3simjetPtTrackEtaFlavour->GetXaxis()->FindBin(HfJetTagging::binsJetPt[binJetPt]);
        TH1F* projJetPtRangeTrackEta = reinterpret_cast<TH1F*> (h3simjetPtTrackEtaFlavour->ProjectionY(Form("projJetPtRagneTrackEta_%d_%d", binJetPt, binZ), leftbinJetPtTrackEta, rightbinJetPtTrackEta, binZ, binZ));
        hsimjetTrackEta[i+1][binJetPt] = reinterpret_cast<TH1F*>(projJetPtRangeTrackEta->Clone());
        hsimjetTrackEta[0][binJetPt]->Add(projJetPtRangeTrackEta);

        int leftbinJetPtTrackPhi = h3simjetPtTrackPhiFlavour->GetXaxis()->FindBin(HfJetTagging::binsJetPt[binJetPt-1]);
        int rightbinJetPtTrackPhi = h3simjetPtTrackPhiFlavour->GetXaxis()->FindBin(HfJetTagging::binsJetPt[binJetPt]);
        TH1F* projJetPtRangeTrackPhi = reinterpret_cast<TH1F*> (h3simjetPtTrackPhiFlavour->ProjectionY(Form("projJetPtRagneTrackPhi_%d_%d", binJetPt, binZ), leftbinJetPtTrackPhi, rightbinJetPtTrackPhi, binZ, binZ));
        hsimjetTrackPhi[i+1][binJetPt] = reinterpret_cast<TH1F*>(projJetPtRangeTrackPhi->Clone());
        hsimjetTrackPhi[0][binJetPt]->Add(projJetPtRangeTrackPhi);

        int leftbinJetPtImpXY = h3simjetPtImpXYFlavour->GetXaxis()->FindBin(HfJetTagging::binsJetPt[binJetPt-1]);
        int rightbinJetPtImpXY = h3simjetPtImpXYFlavour->GetXaxis()->FindBin(HfJetTagging::binsJetPt[binJetPt]);
        TH1F* projJetPtRangeImpXY = reinterpret_cast<TH1F*> (h3simjetPtImpXYFlavour->ProjectionY(Form("projJetPtRagneImpXY_%d_%d", binJetPt, binZ), leftbinJetPtImpXY, rightbinJetPtImpXY, binZ, binZ));
        hsimjetImpXY[i+1][binJetPt] = reinterpret_cast<TH1F*>(projJetPtRangeImpXY->Clone());
        hsimjetImpXY[0][binJetPt]->Add(projJetPtRangeImpXY);

        int leftbinJetPtSignImpXY = h3simjetPtSignImpXYFlavour->GetXaxis()->FindBin(HfJetTagging::binsJetPt[binJetPt-1]);
        int rightbinJetPtSignImpXY = h3simjetPtSignImpXYFlavour->GetXaxis()->FindBin(HfJetTagging::binsJetPt[binJetPt]);
        TH1F* projJetPtRangeSignImpXY = reinterpret_cast<TH1F*>(h3simjetPtSignImpXYFlavour->ProjectionY(Form("projJetPtRagneSignImpXY_%d_%d", binJetPt, binZ), leftbinJetPtSignImpXY, rightbinJetPtSignImpXY, binZ, binZ));
        hsimjetSignImpXY[i+1][binJetPt] = reinterpret_cast<TH1F*>(projJetPtRangeSignImpXY->Clone());
        hsimjetSignImpXY[0][binJetPt]->Add(projJetPtRangeSignImpXY);

        int leftbinJetPtImpXYSig = h3simjetPtImpXYSigFlavour->GetXaxis()->FindBin(HfJetTagging::binsJetPt[binJetPt-1]);
        int rightbinJetPtImpXYSig = h3simjetPtImpXYSigFlavour->GetXaxis()->FindBin(HfJetTagging::binsJetPt[binJetPt]);
        TH1F* projJetPtRangeImpXYSig = reinterpret_cast<TH1F*> (h3simjetPtImpXYSigFlavour->ProjectionY(Form("projJetPtRagneImpXYSig_%d_%d", binJetPt, binZ), leftbinJetPtImpXYSig, rightbinJetPtImpXYSig, binZ, binZ));
        hsimjetImpXYSig[i+1][binJetPt] = reinterpret_cast<TH1F*>(projJetPtRangeImpXYSig->Clone());
        hsimjetImpXYSig[0][binJetPt]->Add(projJetPtRangeImpXYSig);

        int leftbinJetPtSignImpXYSig = h3simjetPtSignImpXYSigFlavour->GetXaxis()->FindBin(HfJetTagging::binsJetPt[binJetPt-1]);
        int rightbinJetPtSignImpXYSig = h3simjetPtSignImpXYSigFlavour->GetXaxis()->FindBin(HfJetTagging::binsJetPt[binJetPt]);
        TH1F* projJetPtRangeSignImpXYSig = reinterpret_cast<TH1F*>(h3simjetPtSignImpXYSigFlavour->ProjectionY(Form("projJetPtRagneSignImpXYSig_%d_%d", binJetPt, binZ), leftbinJetPtSignImpXYSig, rightbinJetPtSignImpXYSig, binZ, binZ));
        hsimjetSignImpXYSig[i+1][binJetPt] = reinterpret_cast<TH1F*>(projJetPtRangeSignImpXYSig->Clone());
        hsimjetSignImpXYSig[0][binJetPt]->Add(projJetPtRangeSignImpXYSig);

        int leftbinJetPtImpZ = h3simjetPtImpZFlavour->GetXaxis()->FindBin(HfJetTagging::binsJetPt[binJetPt-1]);
        int rightbinJetPtImpZ = h3simjetPtImpZFlavour->GetXaxis()->FindBin(HfJetTagging::binsJetPt[binJetPt]);
        TH1F* projJetPtRangeImpZ = reinterpret_cast<TH1F*>(h3simjetPtImpZFlavour->ProjectionY(Form("projJetPtRagneImpZ_%d_%d", binJetPt, binZ), leftbinJetPtImpZ, rightbinJetPtImpZ, binZ, binZ));
        hsimjetImpZ[i+1][binJetPt] = reinterpret_cast<TH1F*>(projJetPtRangeImpZ->Clone());
        hsimjetImpZ[0][binJetPt]->Add(projJetPtRangeImpZ);

        int leftbinJetPtSignImpZ = h3simjetPtSignImpZFlavour->GetXaxis()->FindBin(HfJetTagging::binsJetPt[binJetPt-1]);
        int rightbinJetPtSignImpZ = h3simjetPtSignImpZFlavour->GetXaxis()->FindBin(HfJetTagging::binsJetPt[binJetPt]);
        TH1F* projJetPtRangeSignImpZ = reinterpret_cast<TH1F*>(h3simjetPtSignImpZFlavour->ProjectionY(Form("projJetPtRagneSignImpZ_%d_%d", binJetPt, binZ), leftbinJetPtSignImpZ, rightbinJetPtSignImpZ, binZ, binZ));
        hsimjetSignImpZ[i+1][binJetPt] = reinterpret_cast<TH1F*>(projJetPtRangeSignImpZ->Clone());
        hsimjetSignImpZ[0][binJetPt]->Add(projJetPtRangeSignImpZ);
        int leftbinJetPtImpZSig = h3simjetPtImpZSigFlavour->GetXaxis()->FindBin(HfJetTagging::binsJetPt[binJetPt-1]);
        int rightbinJetPtImpZSig = h3simjetPtImpZSigFlavour->GetXaxis()->FindBin(HfJetTagging::binsJetPt[binJetPt]);
        TH1F* projJetPtRangeImpZSig = reinterpret_cast<TH1F*>(h3simjetPtImpZSigFlavour->ProjectionY(Form("projJetPtRagneImpZSig_%d_%d", binJetPt, binZ), leftbinJetPtImpZSig, rightbinJetPtImpZSig, binZ, binZ));
        hsimjetImpZSig[i+1][binJetPt] = reinterpret_cast<TH1F*>(projJetPtRangeImpZSig->Clone());
        hsimjetImpZSig[0][binJetPt]->Add(projJetPtRangeImpZSig);

        int leftbinJetPtSignImpZSig = h3simjetPtSignImpZSigFlavour->GetXaxis()->FindBin(HfJetTagging::binsJetPt[binJetPt-1]);
        int rightbinJetPtSignImpZSig = h3simjetPtSignImpZSigFlavour->GetXaxis()->FindBin(HfJetTagging::binsJetPt[binJetPt]);
        TH1F* projJetPtRangeSignImpZSig = reinterpret_cast<TH1F*>(h3simjetPtSignImpZSigFlavour->ProjectionY(Form("projJetPtRagneSignImpZSig_%d_%d", binJetPt, binZ), leftbinJetPtSignImpZSig, rightbinJetPtSignImpZSig, binZ, binZ));
        hsimjetSignImpZSig[i+1][binJetPt] = reinterpret_cast<TH1F*>(projJetPtRangeSignImpZSig->Clone());
        hsimjetSignImpZSig[0][binJetPt]->Add(projJetPtRangeSignImpZSig);
int leftbinJetPtImpXYZ = h3simjetPtImpXYZFlavour->GetXaxis()->FindBin(HfJetTagging::binsJetPt[binJetPt-1]);
        int rightbinJetPtImpXYZ = h3simjetPtImpXYZFlavour->GetXaxis()->FindBin(HfJetTagging::binsJetPt[binJetPt]);
        TH1F* projJetPtRangeImpXYZ = reinterpret_cast<TH1F*>(h3simjetPtImpXYZFlavour->ProjectionY(Form("projJetPtRagneImpXYZ_%d_%d", binJetPt, binZ), leftbinJetPtImpXYZ, rightbinJetPtImpXYZ, binZ, binZ));
        hsimjetImpXYZ[i+1][binJetPt] = reinterpret_cast<TH1F*>(projJetPtRangeImpXYZ->Clone());
        hsimjetImpXYZ[0][binJetPt]->Add(projJetPtRangeImpXYZ);

        int leftbinJetPtSignImpXYZ = h3simjetPtSignImpXYZFlavour->GetXaxis()->FindBin(HfJetTagging::binsJetPt[binJetPt-1]);
        int rightbinJetPtSignImpXYZ = h3simjetPtSignImpXYZFlavour->GetXaxis()->FindBin(HfJetTagging::binsJetPt[binJetPt]);
        TH1F* projJetPtRangeSignImpXYZ = reinterpret_cast<TH1F*>(h3simjetPtSignImpXYZFlavour->ProjectionY(Form("projJetPtRagneSignImpXYZ_%d_%d", binJetPt, binZ), leftbinJetPtSignImpXYZ, rightbinJetPtSignImpXYZ, binZ, binZ));
        hsimjetSignImpXYZ[i+1][binJetPt] = reinterpret_cast<TH1F*>(projJetPtRangeSignImpXYZ->Clone());
        hsimjetSignImpXYZ[0][binJetPt]->Add(projJetPtRangeSignImpXYZ);
        int leftbinJetPtImpXYZSig = h3simjetPtImpXYZSigFlavour->GetXaxis()->FindBin(HfJetTagging::binsJetPt[binJetPt-1]);
        int rightbinJetPtImpXYZSig = h3simjetPtImpXYZSigFlavour->GetXaxis()->FindBin(HfJetTagging::binsJetPt[binJetPt]);
        TH1F* projJetPtRangeImpXYZSig = reinterpret_cast<TH1F*>(h3simjetPtImpXYZSigFlavour->ProjectionY(Form("projJetPtRagneImpXYZSig_%d_%d", binJetPt, binZ), leftbinJetPtImpXYZSig, rightbinJetPtImpXYZSig, binZ, binZ));
        hsimjetImpXYZSig[i+1][binJetPt] = reinterpret_cast<TH1F*>(projJetPtRangeImpXYZSig->Clone());
        hsimjetImpXYZSig[0][binJetPt]->Add(projJetPtRangeImpXYZSig);

        int leftbinJetPtSignImpXYZSig = h3simjetPtSignImpXYZSigFlavour->GetXaxis()->FindBin(HfJetTagging::binsJetPt[binJetPt-1]);
        int rightbinJetPtSignImpXYZSig = h3simjetPtSignImpXYZSigFlavour->GetXaxis()->FindBin(HfJetTagging::binsJetPt[binJetPt]);
        TH1F* projJetPtRangeSignImpXYZSig = reinterpret_cast<TH1F*>(h3simjetPtSignImpXYZSigFlavour->ProjectionY(Form("projJetPtRagneSignImpXYZSig_%d_%d", binJetPt, binZ), leftbinJetPtSignImpXYZSig, rightbinJetPtSignImpXYZSig, binZ, binZ));
        hsimjetSignImpXYZSig[i+1][binJetPt] = reinterpret_cast<TH1F*>(projJetPtRangeSignImpXYZSig->Clone());
        hsimjetSignImpXYZSig[0][binJetPt]->Add(projJetPtRangeSignImpXYZSig);

      }
    }
  }
}

void HfJetTaggingTCAnalysis::CloneNormalizedHistogram(bool doTC, bool doJP) {
  if (doTC) {
    for (int flavour = 0; flavour < HfJetTagging::nFlavour+1; flavour++) {
      for (int jetPt = 0; jetPt < HfJetTagging::nBinsJetPt+1; jetPt++) {
        hsimjetNormalizedTrackPt[flavour][jetPt] = (TH1F*) hsimjetTrackPt[flavour][jetPt]->Clone(Form("hsimjetNormalizedTrackPt_%d_%d", flavour, jetPt));
        hsimjetNormalizedTrackEta[flavour][jetPt] = (TH1F*) hsimjetTrackEta[flavour][jetPt]->Clone(Form("hsimjetNormalizedTrackEta_%d_%d", flavour, jetPt));
        hsimjetNormalizedTrackPhi[flavour][jetPt] = (TH1F*) hsimjetTrackPhi[flavour][jetPt]->Clone(Form("hsimjetNormalizedTrackPhi_%d_%d", flavour, jetPt));
        hsimjetNormalizedImpXY[flavour][jetPt] = (TH1F*) hsimjetImpXY[flavour][jetPt]->Clone(Form("hsimjetNormalizedImpXY_%d_%d", flavour, jetPt));
        hsimjetNormalizedSignImpXY[flavour][jetPt] = (TH1F*) hsimjetSignImpXY[flavour][jetPt]->Clone(Form("hsimjetNormalizedSignImpXY_%d_%d", flavour, jetPt));
        hsimjetNormalizedImpXYSig[flavour][jetPt] = (TH1F*) hsimjetImpXYSig[flavour][jetPt]->Clone(Form("hsimjetNormalizedImpXYSig_%d_%d", flavour, jetPt));
        hsimjetNormalizedSignImpXYSig[flavour][jetPt] = (TH1F*) hsimjetSignImpXYSig[flavour][jetPt]->Clone(Form("hsimjetNormalizedSignImpXYSig_%d_%d", flavour, jetPt));
        hsimjetNormalizedImpZ[flavour][jetPt] = (TH1F*) hsimjetImpZ[flavour][jetPt]->Clone(Form("hsimjetNormalizedImpZ_%d_%d", flavour, jetPt));
        hsimjetNormalizedSignImpZ[flavour][jetPt] = (TH1F*) hsimjetSignImpZ[flavour][jetPt]->Clone(Form("hsimjetNormalizedSignImpZ_%d_%d", flavour, jetPt));
        hsimjetNormalizedImpZSig[flavour][jetPt] = (TH1F*) hsimjetImpZSig[flavour][jetPt]->Clone(Form("hsimjetNormalizedImpZSig_%d_%d", flavour, jetPt));
        hsimjetNormalizedSignImpZSig[flavour][jetPt] = (TH1F*) hsimjetSignImpZSig[flavour][jetPt]->Clone(Form("hsimjetNormalizedSignImpZSig_%d_%d", flavour, jetPt));
        hsimjetNormalizedImpXYZ[flavour][jetPt] = (TH1F*) hsimjetImpXYZ[flavour][jetPt]->Clone(Form("hsimjetNormalizedImpXYZ_%d_%d", flavour, jetPt));
        hsimjetNormalizedSignImpXYZ[flavour][jetPt] = (TH1F*) hsimjetSignImpXYZ[flavour][jetPt]->Clone(Form("hsimjetNormalizedSignImpXYZ_%d_%d", flavour, jetPt));
        hsimjetNormalizedImpXYZSig[flavour][jetPt] = (TH1F*) hsimjetImpXYZSig[flavour][jetPt]->Clone(Form("hsimjetNormalizedImpXYZSig_%d_%d", flavour, jetPt));
        hsimjetNormalizedSignImpXYZSig[flavour][jetPt] = (TH1F*) hsimjetSignImpXYZSig[flavour][jetPt]->Clone(Form("hsimjetNormalizedSignImpXYZSig_%d_%d", flavour, jetPt));
        hsimjetNormalizedSignImpXYSigN1[flavour][jetPt] = (TH1F*) hsimjetSignImpXYSigN1[flavour][jetPt]->Clone(Form("hsimjetNormalizedSignImpXYSigN1_%d_%d", flavour, jetPt));
        hsimjetNormalizedSignImpXYSigN2[flavour][jetPt] = (TH1F*) hsimjetSignImpXYSigN2[flavour][jetPt]->Clone(Form("hsimjetNormalizedSignImpXYSigN2_%d_%d", flavour, jetPt));
        hsimjetNormalizedSignImpXYSigN3[flavour][jetPt] = (TH1F*) hsimjetSignImpXYSigN3[flavour][jetPt]->Clone(Form("hsimjetNormalizedSignImpXYSigN3_%d_%d", flavour, jetPt));
      }
    }
  }
}

void HfJetTaggingTCAnalysis::NormalizedHistogram(bool doTC, bool doJP) {
  if (doTC) {
    for (int flavour = 0; flavour < HfJetTagging::nFlavour+1; flavour++) {
      for (int jetPt = 0; jetPt < HfJetTagging::nBinsJetPt+1; jetPt++) {
        hsimjetNormalizedTrackPt[flavour][jetPt]->Scale(1. / hsimjetNormalizedTrackPt[flavour][jetPt]->GetEntries());
        hsimjetNormalizedTrackEta[flavour][jetPt]->Scale(1. / hsimjetNormalizedTrackEta[flavour][jetPt]->GetEntries());
        hsimjetNormalizedTrackPhi[flavour][jetPt]->Scale(1. / hsimjetNormalizedTrackPhi[flavour][jetPt]->GetEntries());
        hsimjetNormalizedImpXY[flavour][jetPt]->Scale(1. / hsimjetNormalizedImpXY[flavour][jetPt]->Integral());
        hsimjetNormalizedSignImpXY[flavour][jetPt]->Scale(1. / hsimjetNormalizedSignImpXY[flavour][jetPt]->Integral());
        hsimjetNormalizedImpXYSig[flavour][jetPt]->Scale(1. / hsimjetNormalizedImpXYSig[flavour][jetPt]->Integral());

        hsimjetNormalizedSignImpXYSig[flavour][jetPt]->Scale(1. / hsimjetNormalizedSignImpXYSig[flavour][jetPt]->Integral());
        //std::cout << "entries: " << hsimjetNormalizedSignImpXYSig[flavour][jetPt]->GetEntries() << " intergral: " << hsimjetNormalizedSignImpXYSig[flavour][jetPt]->Integral(1, hsimjetNormalizedSignImpXYSig[flavour][jetPt]->GetNbinsX()) << std::endl;

        hsimjetNormalizedImpZ[flavour][jetPt]->Scale(1. / hsimjetNormalizedImpZ[flavour][jetPt]->GetEntries());
        hsimjetNormalizedSignImpZ[flavour][jetPt]->Scale(1. / hsimjetNormalizedSignImpZ[flavour][jetPt]->GetEntries());
        hsimjetNormalizedImpZSig[flavour][jetPt]->Scale(1. / hsimjetNormalizedImpZSig[flavour][jetPt]->GetEntries());
        hsimjetNormalizedSignImpZSig[flavour][jetPt]->Scale(1. / hsimjetNormalizedSignImpZSig[flavour][jetPt]->GetEntries());
        hsimjetNormalizedImpXYZ[flavour][jetPt]->Scale(1. / hsimjetNormalizedImpXYZ[flavour][jetPt]->GetEntries());
        hsimjetNormalizedSignImpXYZ[flavour][jetPt]->Scale(1. / hsimjetNormalizedSignImpXYZ[flavour][jetPt]->GetEntries());
        hsimjetNormalizedImpXYZSig[flavour][jetPt]->Scale(1. / hsimjetNormalizedImpXYZSig[flavour][jetPt]->GetEntries());
        hsimjetNormalizedSignImpXYZSig[flavour][jetPt]->Scale(1. / hsimjetNormalizedSignImpXYZSig[flavour][jetPt]->GetEntries());
        hsimjetNormalizedSignImpXYSigN1[flavour][jetPt]->Scale(1. / hsimjetNormalizedSignImpXYSigN1[flavour][jetPt]->Integral());
        hsimjetNormalizedSignImpXYSigN2[flavour][jetPt]->Scale(1. / hsimjetNormalizedSignImpXYSigN2[flavour][jetPt]->Integral());
        hsimjetNormalizedSignImpXYSigN3[flavour][jetPt]->Scale(1. / hsimjetNormalizedSignImpXYSigN3[flavour][jetPt]->Integral());

      }
    }
    hsimlfjetNormalizedTrackPt->Scale(1. / hsimlfjetNormalizedTrackPt->GetEntries());
    hsimlfjetNormalizedTrackPhi->Scale(1. / hsimlfjetNormalizedTrackPhi->GetEntries());
    hsimlfjetNormalizedTrackEta->Scale(1. / hsimlfjetNormalizedTrackEta->GetEntries());

    hsimcjetNormalizedTrackPt->Scale(1. / hsimcjetNormalizedTrackPt->GetEntries());
    hsimcjetNormalizedTrackPhi->Scale(1. / hsimcjetNormalizedTrackPhi->GetEntries());
    hsimcjetNormalizedTrackEta->Scale(1. / hsimcjetNormalizedTrackEta->GetEntries());

    hsimbjetNormalizedTrackPt->Scale(1. / hsimbjetNormalizedTrackPt->GetEntries());
    hsimbjetNormalizedTrackPhi->Scale(1. / hsimbjetNormalizedTrackPhi->GetEntries());
    hsimbjetNormalizedTrackEta->Scale(1. / hsimbjetNormalizedTrackEta->GetEntries());

    hsimlfjetNormalizedImpXY->Scale(1. / hsimlfjetNormalizedImpXY->GetEntries());
    hsimcjetNormalizedImpXY->Scale(1. / hsimcjetNormalizedImpXY->GetEntries());
    hsimbjetNormalizedImpXY->Scale(1. / hsimbjetNormalizedImpXY->GetEntries());
    hsimlfjetNormalizedSignImpXY->Scale(1. / hsimlfjetNormalizedSignImpXY->GetEntries());
    hsimcjetNormalizedSignImpXY->Scale(1. / hsimcjetNormalizedSignImpXY->GetEntries());
    hsimbjetNormalizedSignImpXY->Scale(1. / hsimbjetNormalizedSignImpXY->GetEntries());

    hsimlfjetNormalizedImpXYSignificance->Scale(1. / hsimlfjetNormalizedImpXYSignificance->GetEntries());
    hsimlfjetNormalizedSignImpXYSignificance->Scale(1. / hsimlfjetNormalizedSignImpXYSignificance->GetEntries());
    //hsimlfjetNormalizedPtSignImpXYSignificance->Scale(1. / hsimlfjetNormalizedPtSignImpXYSignificance->GetEntries());

    hsimcjetNormalizedImpXYSignificance->Scale  (1. / hsimcjetNormalizedImpXYSignificance->GetEntries());
    hsimcjetNormalizedSignImpXYSignificance->Scale(1. / hsimcjetNormalizedSignImpXYSignificance->GetEntries());
    //hsimcjetNormalizedPtSignImpXYSignificance->Scale(1. / hsimcjetNormalizedPtSignImpXYSignificance->GetEntries());

    hsimbjetNormalizedImpXYSignificance->Scale(1. / hsimbjetNormalizedImpXYSignificance->GetEntries());
    hsimbjetNormalizedSignImpXYSignificance->Scale(1. / hsimbjetNormalizedSignImpXYSignificance->GetEntries());
    //hsimbjetNormalizedPtSignImpXYSignificance->Scale(1. / hsimbjetNormalizedPtSignImpXYSignificance->GetEntries());

    hsimlfjetNormalizedImpXYZ->Scale(1. / hsimlfjetNormalizedImpXYZ->GetEntries());
    hsimlfjetNormalizedSignImpXYZ->Scale(1. / hsimlfjetNormalizedSignImpXYZ->GetEntries());
    hsimlfjetNormalizedImpXYZSignificance->Scale(1. / hsimlfjetNormalizedImpXYZSignificance->GetEntries());
    hsimlfjetNormalizedSignImpXYZSignificance->Scale(1. / hsimlfjetNormalizedSignImpXYZSignificance->GetEntries());

    hsimcjetNormalizedImpXYZ->Scale(1. / hsimcjetNormalizedImpXYZ->GetEntries());
    hsimcjetNormalizedSignImpXYZ->Scale(1. / hsimcjetNormalizedSignImpXYZ->GetEntries());
    hsimcjetNormalizedImpXYZSignificance->Scale(1. / hsimcjetNormalizedImpXYZSignificance->GetEntries());
    hsimcjetNormalizedSignImpXYZSignificance->Scale(1. / hsimcjetNormalizedSignImpXYZSignificance->GetEntries());

    hsimbjetNormalizedImpXYZ->Scale(1. / hsimbjetNormalizedImpXYZ->GetEntries());
    hsimbjetNormalizedSignImpXYZ->Scale(1. / hsimbjetNormalizedSignImpXYZ->GetEntries());
    hsimbjetNormalizedImpXYZSignificance->Scale(1. / hsimbjetNormalizedImpXYZSignificance->GetEntries());
